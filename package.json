{
  "name": "popcorn-ai",
  "private": true,
  "description": "Tracing, replay and regression evals for tool-calling AI agents",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel --filter=@popcornai/api --filter=@popcornai/dashboard",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @popcornai/dashboard test:e2e",
    "db:generate": "pnpm --filter @popcornai/db generate",
    "db:migrate": "pnpm --filter @popcornai/db migrate",
    "db:seed": "pnpm --filter @popcornai/db seed",
    "bench:sdk": "pnpm --filter @popcornai/sdk bench",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "turbo": "^2.11.7",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3.2.7"
  }
}
