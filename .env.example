# Shared
DATABASE_URL=postgres://postgres:postgres@localhost:5432/popcorn

# API
PORT=4100
# Leave unset to process spans inline instead of through BullMQ.
REDIS_URL=redis://localhost:6379
# Delete runs older than this many days. 0 disables retention.
RETENTION_DAYS=0

# Dashboard
# Set to true for the public demo: hides key management and all write actions.
POPCORN_READ_ONLY=false

# SDK / CLI
POPCORN_ENDPOINT=http://localhost:4100
POPCORN_API_KEY=
ANTHROPIC_API_KEY=
