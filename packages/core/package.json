{
  "name": "@popcornai/core",
  "version": "0.1.1",
  "description": "Shared domain model for Popcorn AI: span schema, model pricing, anomaly flags, run diffing and eval checks",
  "keywords": [
    "ai",
    "agents",
    "llm",
    "tracing",
    "evals",
    "popcorn"
  ],
  "license": "MIT",
  "author": "Alok Mishra (https://github.com/alokmishra70)",
  "homepage": "https://github.com/alokmishra70/popcorn-ai#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/alokmishra70/popcorn-ai",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/alokmishra70/popcorn-ai/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "zod": "^4.3.3"
  },
  "devDependencies": {
    "tsup": "^8.5.1"
  }
}
