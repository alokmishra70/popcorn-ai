{
  "name": "@popcornai/cli",
  "version": "0.1.1",
  "description": "Popcorn CLI: run eval suites (popcorn review), replay runs (popcorn rewind) and tail live runs (popcorn watch)",
  "keywords": [
    "ai",
    "agents",
    "llm",
    "evals",
    "replay",
    "cli",
    "github-action",
    "popcorn"
  ],
  "license": "MIT",
  "author": "Alok Mishra (https://github.com/alokmishra70)",
  "homepage": "https://github.com/alokmishra70/popcorn-ai#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/alokmishra70/popcorn-ai",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/alokmishra70/popcorn-ai/issues"
  },
  "type": "module",
  "bin": {
    "popcorn": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@popcornai/core": "workspace:^",
    "@popcornai/sdk": "workspace:^",
    "commander": "^12.1.0",
    "jiti": "^2.7.0",
    "p-limit": "^7.3.3"
  },
  "devDependencies": {
    "tsup": "^8.5.1"
  }
}
