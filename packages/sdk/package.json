{
  "name": "@popcornai/sdk",
  "version": "0.1.1",
  "description": "Record, replay and evaluate tool-calling AI agents. Wrap your LLM client and tools once; every run becomes a trace.",
  "keywords": [
    "ai",
    "agents",
    "llm",
    "tracing",
    "observability",
    "evals",
    "anthropic",
    "openai"
  ],
  "license": "MIT",
  "author": "Alok Mishra (https://github.com/alokmishra70)",
  "homepage": "https://github.com/alokmishra70/popcorn-ai#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/alokmishra70/popcorn-ai",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/alokmishra70/popcorn-ai/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage.enabled --coverage.include=src",
    "bench": "tsx bench/span-overhead.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@popcornai/core": "workspace:^"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.7",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15"
  }
}
