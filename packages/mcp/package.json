{
  "name": "@popcornai/mcp",
  "version": "0.1.1",
  "description": "MCP server for Popcorn: lets Claude or another agent search runs, read traces and run eval suites",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "ai",
    "agents",
    "tracing",
    "popcorn"
  ],
  "license": "MIT",
  "author": "Alok Mishra (https://github.com/alokmishra70)",
  "homepage": "https://github.com/alokmishra70/popcorn-ai#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/alokmishra70/popcorn-ai",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/alokmishra70/popcorn-ai/issues"
  },
  "type": "module",
  "bin": {
    "popcorn-mcp": "./dist/server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/tools.d.ts",
      "import": "./dist/tools.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@popcornai/cli": "workspace:^",
    "@popcornai/core": "workspace:^",
    "zod": "^4.3.3"
  },
  "devDependencies": {
    "tsup": "^8.5.1"
  }
}
